@@ -42,7 +42,21 @@ function serial(tasks, function_) {
 }
 const defaultTask = { run: (function_) => function_() };
 const _createTask = () => defaultTask;
-const createTask = typeof console.createTask !== "undefined" ? console.createTask : _createTask;
+const createTask = (() => {
+  // PATCH: probe that the method WORKS, not merely that it exists.
+  // Cloudflare workerd defines console.createTask and throws
+  // ERR_METHOD_NOT_IMPLEMENTED when it is called, so an existence check
+  // adopts a method that cannot run and every hook call throws. On a Nuxt
+  // worker that is every route, served as a 500.
+  // Reached once at module init, so the cost is a single call.
+  if (typeof console.createTask === "undefined") return _createTask;
+  try {
+    console.createTask("hookable-probe").run(() => {});
+  } catch {
+    return _createTask;
+  }
+  return console.createTask;
+})();
 function serialTaskCaller(hooks, args) {
   const name = args.shift();
   const task = createTask(name);
